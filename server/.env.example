# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────
# Replace <username>, <password>, <cluster> with your Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/qusamba_erp?retryWrites=true&w=majority

# ─── Database Initialization Mode ────────────────────────
# Options:
# 'clean' -> Fresh production slate (0 dummy invoices, 0 fake buyers, clean sizing master)
# 'demo'  -> Populate with realistic sample data for demo/training
# 'false' -> Do not auto-seed, keep database untouched
AUTO_SEED=clean

# ─── JWT Authentication ──────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── CORS — Vite React Frontend Origin ──────────────────
CLIENT_URL=http://localhost:5173

# ─── Cloudflare R2 (S3-compatible) ───────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=qusamba-backups
